{
  // Cloudflare Workers, serving the built site (out/) as static files.
  // Build: `npm run build`. Deploy: `npm run deploy`, or let Cloudflare build
  // from GitHub with the same two commands.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peanutallergycards",
  "compatibility_date": "2026-11-01",
  // The real address. www.peanutallergycards.com is sent here by a redirect
  // rule on the domain in Cloudflare, not by this file.
  "routes": [{ "pattern": "peanutallergycards.com", "custom_domain": true }],
  // Also at peanutallergycards.<account>.workers.dev, as a test address
  // (never indexed: see public/_headers). No separate preview addresses.
  "workers_dev": true,
  "preview_urls": false,
  // Keep logs for any Worker code added later (checkout). Plain files don't
  // run code, so they produce no log lines.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./out",
    // /thailand is served from thailand.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
