{
  // Cloudflare Workers, serving the built site (out/) as static files, plus
  // a few lines of code for the mailing list.
  // Build: `npm run build`. Deploy: `npm run deploy`, or let Cloudflare build
  // from GitHub with the same two commands.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peanutallergycards",
  "compatibility_date": "2026-11-01",
  // The real address. www.peanutallergycards.com is sent here by a redirect
  // rule on the domain in Cloudflare, not by this file.
  "routes": [{ "pattern": "peanutallergycards.com", "custom_domain": true }],
  // Also at peanutallergycards.<account>.workers.dev, as a test address
  // (never indexed: see public/_headers). No separate preview addresses.
  "workers_dev": true,
  "preview_urls": false,
  // Keep logs for the Worker code. Plain files don't run code, so they
  // produce no log lines.
  "observability": { "enabled": true },
  // The only code that runs: the mailing list. See worker/index.ts.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /thailand is served from thailand.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these addresses run the Worker. Every page and file is served
    // directly, which is free and unlimited.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // The mailing list. Created 2026-11-23; the table is in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peanutallergycards",
      "database_id": "dbe3f8e4-6c02-404c-a0f1-f51b17dc0d68",
      "migrations_dir": "migrations"
    }
  ]
}
