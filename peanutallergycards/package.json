{
  "name": "peanutallergycards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run images && next build",
    "check": "ultracite check",
    "deploy": "npm run build && wrangler deploy",
    "dev": "next dev",
    "fix": "ultracite fix",
    "images": "node scripts/build-images.mjs",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit && wrangler types worker/worker-configuration.d.ts > /dev/null && tsc --noEmit -p worker"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "country-flag-icons": "1.6.20",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "ultracite": "8.3.1",
    "wrangler": "4.158.0"
  }
}
