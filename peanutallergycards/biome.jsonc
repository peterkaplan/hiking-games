{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  // Left as they are: third-party flag artwork (country-flag-icons), the
  // image list written by scripts/build-images.mjs, and Cloudflare's types.
  "files": {
    "includes": [
      "!public/flags",
      "!src/images/variants.json",
      "!worker/worker-configuration.d.ts"
    ]
  }
}
